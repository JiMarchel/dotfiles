// Generated by Noctalia from the active wallpaper palette.
// Do not edit by hand: changes are overwritten on every theme change.
// Source template: ~/.config/noctalia/templates/niri-theme.kdl

layout {
    border {
        // Thin border, palette-driven colors.
        width 2

        active-color "#c0c7d7"
        inactive-color "#45474c"
        urgent-color "#ffb4ab"
    }

    focus-ring {
        off
    }

    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=6
        color "#00000060"
    }
}

overview {
    backdrop-color "#000000"
}
