// Generated by Noctalia from the active wallpaper palette.
// Do not edit by hand: changes are overwritten on every theme change.
// Source template: ~/.config/noctalia/templates/niri-theme.kdl

layout {
    border {
        // Thin border, palette-driven colors.
        width 2

        active-color "{{ colors.primary.default.hex }}"
        inactive-color "{{ colors.outline_variant.default.hex }}"
        urgent-color "{{ colors.error.default.hex }}"
    }

    focus-ring {
        off
    }

    shadow {
        on
        softness 40
        spread 0
        offset x=0 y=6
        color "#00000060"
    }
}

overview {
    backdrop-color "{{ colors.scrim.default.hex }}"
}
