#!/bin/bash
# Omarchy-style ASCII screensaver for niri + kitty
# Usage: screensaver [force]

ASCII_FILE="$HOME/.config/screensaver/ascii.txt"
LOCK_CMD="noctalia msg lock-toggle"

# If not forced, check if screensaver is toggled off
if [[ "$1" != "force" ]]; then
  TOGGLE_FILE="$HOME/.config/screensaver/disabled"
  [[ -f "$TOGGLE_FILE" ]] && exit 0
fi

# Exit if already running
pgrep -f "class=screensaver" >/dev/null 2>&1 && exit 0

# Pick a random animation from available tools
ANIMATIONS=()
command -v cmatrix >/dev/null 2>&1 && ANIMATIONS+=("cmatrix")
command -v asciiquarium >/dev/null 2>&1 && ANIMATIONS+=("asciiquarium")
command -v cbonsai >/dev/null 2>&1 && ANIMATIONS+=("cbonsai")
command -v tte >/dev/null 2>&1 && ANIMATIONS+=("tte")

if [[ ${#ANIMATIONS[@]} -eq 0 ]]; then
  notify-send -u critical "Screensaver" "No animation tools installed. Install cmatrix, asciiquarium, or cbonsai."
  exit 1
fi

PICKED=${ANIMATIONS[$RANDOM % ${#ANIMATIONS[@]}]}

# Spawn fullscreen kitty per monitor with animation
for output in $(niri msg outputs 2>/dev/null | grep "Output " | awk '{print $2}'); do
  case "$PICKED" in
    cmatrix)
      kitty --start-as=fullscreen --class=screensaver \
        -o allow_remote_control=yes \
        sh -c "cmatrix -absu 0; read -n1" &
      ;;
    asciiquarium)
      kitty --start-as=fullscreen --class=screensaver \
        -o allow_remote_control=yes \
        sh -c "asciiquarium; read -n1" &
      ;;
    cbonsai)
      kitty --start-as=fullscreen --class=screensaver \
        -o allow_remote_control=yes \
        sh -c "cbonsai -li; read -n1" &
      ;;
    tte)
      kitty --start-as=fullscreen --class=screensaver \
        -o allow_remote_control=yes \
        sh -c "tte '$ASCII_FILE' --random-effect 2>/dev/null || cat '$ASCII_FILE'; read -n1" &
      ;;
  esac
done

# Wait for any keypress or mouse movement to dismiss
while true; do
  sleep 1
  # Exit if no kitty screensaver process remains
  pgrep -f "class=screensaver" >/dev/null 2>&1 || break
done
