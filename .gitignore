# zsh local overrides (machine-specific)
home/.config/zsh/local.zsh
home/.config/zsh/.gitignore
home/.config/zsh/.zcompdump*
home/.config/zsh/.zhistory

# zsh plugins (re-cloned by plugins.zsh on first launch)
home/.config/zsh/plugins/

# niri backup files
home/.config/niri/config.kdl.bak-*

# noctalia runtime state (not config, regenerated on each run)
home/.config/noctalia/settings.toml
home/.config/noctalia/state.toml
home/.config/noctalia/recently_used.json
home/.config/noctalia/usage_counts.json
home/.config/noctalia/.setup-complete
home/.config/noctalia/clipboard/
home/.config/noctalia/notification_history*
home/.config/noctalia/notification_history_assets/
home/.config/noctalia/community-palettes/
home/.config/noctalia/community-templates/
home/.config/noctalia/plugins/

# generated theme files (regenerated by Noctalia on wallpaper change)
home/.config/kitty/themes/noctalia.conf

# OS noise
.DS_Store
*~
*.swp
